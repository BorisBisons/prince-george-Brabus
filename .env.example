# --- Database (Neon Postgres) ---
# Pooled connection for the app (Neon's -pooler host), direct for migrations.
DATABASE_URL="postgresql://user:password@ep-xxx-pooler.us-west-2.aws.neon.tech/bloombid?sslmode=require"
DIRECT_URL="postgresql://user:password@ep-xxx.us-west-2.aws.neon.tech/bloombid?sslmode=require"

# --- Auth ---
AUTH_SECRET="generate-with: openssl rand -base64 32"
AUTH_TRUST_HOST="true" # required off-Vercel (e.g. local prod builds)
NEXT_PUBLIC_APP_URL="http://localhost:3000"

# --- Stripe ---
STRIPE_SECRET_KEY="sk_test_..."
NEXT_PUBLIC_STRIPE_PUBLISHABLE_KEY="pk_test_..."
STRIPE_WEBHOOK_SECRET="whsec_..."

# --- Resend (email) ---
RESEND_API_KEY="re_..."
EMAIL_FROM="BloomBid <hello@bloombid.ca>"

# --- Twilio (SMS — wired but feature-flagged OFF at launch) ---
SMS_ENABLED="false"
TWILIO_ACCOUNT_SID=""
TWILIO_AUTH_TOKEN=""
TWILIO_FROM_NUMBER=""

# --- Web Push (VAPID) ---
NEXT_PUBLIC_VAPID_PUBLIC_KEY=""
VAPID_PRIVATE_KEY=""
VAPID_SUBJECT="mailto:hello@bloombid.ca"

# --- Pusher (realtime bids) ---
PUSHER_APP_ID=""
PUSHER_SECRET=""
NEXT_PUBLIC_PUSHER_KEY=""
NEXT_PUBLIC_PUSHER_CLUSTER="us3"

# --- Cron (Vercel Cron auth) ---
CRON_SECRET="generate-with: openssl rand -base64 32"

# --- Observability ---
SENTRY_DSN=""
NEXT_PUBLIC_POSTHOG_KEY=""
NEXT_PUBLIC_POSTHOG_HOST="https://us.i.posthog.com"
